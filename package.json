{
  "name": "decimen-optical-transfer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Proof of concept: file transfer between two devices using fountain-coded animated QR codes — screen to camera, no network.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:sender": "vite build --config vite.sender.config.ts",
    "build:sender:web": "vite build --config vite.sender-web.config.ts",
    "build:receiver": "vite build --config vite.receiver-web.config.ts",
    "build:receiver:v2": "vite build --config vite.v2-receiver.config.ts",
    "build:sender:v2": "vite build --config vite.v2-sender.config.ts",
    "build:receiver:v3": "vite build --config vite.v3-receiver.config.ts",
    "build:sender:v3": "vite build --config vite.v3-sender.config.ts",
    "build:color:v3": "node scripts/copy_v3_color.mjs",
    "build:receiver:v4": "vite build --config vite.v4-receiver.config.ts",
    "build:sender:v4": "vite build --config vite.v4-sender.config.ts",
    "dev:sender:v5": "vite --config vite.v5-sender.config.ts",
    "build:sender:v5": "vite build --config vite.v5-sender.config.ts",
    "dev:sender:v51": "vite --config vite.v51-sender.config.ts",
    "build:sender:v51": "vite build --config vite.v51-sender.config.ts",
    "dev:sender:v52": "vite --config vite.v52-sender.config.ts",
    "build:sender:v52": "vite build --config vite.v52-sender.config.ts",
    "dev:sender:v53": "vite --config vite.v53-sender.config.ts",
    "build:sender:v53": "vite build --config vite.v53-sender.config.ts",
    "dev:sender:v54": "vite --config vite.v54-sender.config.ts",
    "build:sender:v54": "vite build --config vite.v54-sender.config.ts",
    "dev:sender:v6": "vite --config vite.v6-sender.config.ts",
    "dev:receiver:v6": "vite --config vite.v6-receiver.config.ts",
    "build:sender:v6": "vite build --config vite.v6-sender.config.ts",
    "build:receiver:v6": "vite build --config vite.v6-receiver.config.ts",
    "build:v6": "npm run build:receiver:v6 && npm run build:sender:v6",
    "preview:v6:lan": "vite preview --config vite.v6-receiver.config.ts --host 0.0.0.0 --port 4176",
    "test:v6": "vitest run v6/shared && vitest run v6/benchmark/fec-loss.test.ts --environment happy-dom",
    "benchmark:v6": "vitest run v6/benchmark/v6-transfer.bench.test.ts --environment happy-dom",
    "build:receiver:xhs": "vite build --config vite.receiver-xhs.config.ts",
    "generate:wasm-inline": "node scripts/generate_inline_wasm.mjs",
    "build:receiver:xhs:inline": "npm run generate:wasm-inline && vite build --config vite.receiver-xhs-inline.config.ts",
    "build:web": "npm run build:receiver && npm run build:sender:web && npm run build:receiver:v2 && npm run build:sender:v2 && npm run build:receiver:v3 && npm run build:sender:v3 && npm run build:color:v3 && npm run build:receiver:v4 && npm run build:sender:v4 && npm run build:sender:v5 && npm run build:sender:v51 && npm run build:sender:v52 && npm run build:sender:v53 && npm run build:sender:v54 && npm run build:v6",
    "build:release": "npm run build:sender && npm run build:web",
    "preview": "vite preview",
    "preview:receiver": "vite preview --config vite.receiver-web.config.ts"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "happy-dom": "^20.11.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "zxing-wasm": "^2.0.0"
  },
  "dependencies": {
    "@raptorqr/core": "0.1.1",
    "@raptorqr/fast-qr-wasm": "0.1.1",
    "@raptorqr/raptorq-wasm": "0.1.1",
    "fflate": "^0.8.3"
  }
}
